# CampusSetu Demo Environment Variables Configuration
# Copy this file to .env before starting the server

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campussetu_demo

# Server Port
PORT=5000

# Authentication & Session Secrets
JWT_SECRET=change_this_jwt_secret_in_production_2026
SESSION_SECRET=change-this-session-secret-key-demo

# Demo Mode Settings
DEMO_MODE=true
DEMO_DATASET_ID=campussetu-demo-01

# Virtual Clock & Simulator
DEMO_CLOCK_ACCELERATION=1
