{
  "name": "campus-setu",
  "version": "1.0.0",
  "description": "CampusSetu - Higher Education Campus ERP & Governance Platform",
  "main": "server/src/index.ts",
  "scripts": {
    "dev:server": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "seed": "ts-node -r tsconfig-paths/register server/src/seed.ts",
    "test": "vitest run --dir server/src/__tests__"
  },
  "keywords": [
    "campus-erp",
    "education",
    "express",
    "react",
    "mongodb",
    "typescript"
  ],
  "author": "CampusSetu Team",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "mongoose": "^8.4.3",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}
